<Layout title="Psicóloga en Mexicali | Terapia de Ansiedad, Pareja y Online – Berenice Bastidas">
	<link slot="head" rel="preload" href="/imagen_inicio.webp" as="image" />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<main class="overflow-visible">
		<Header />
		<div class="pt-[56px] md:mt-[56px]">
			<Hero />
			<Servicios />
			<Sobremi />
			<Testimonios />
			<Preguntas />
			<Ebook />
			<Contacto />
		</div>
	</main>
</Layout>
